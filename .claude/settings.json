{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": [
    "**/Downloads/CLAUDE.md",
    "**/Downloads/PDM/CLAUDE.md"
  ],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(~/Downloads/PDM/**)",
      "WebSearch",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:export.arxiv.org)",
      "WebFetch(domain:neurips.cc)",
      "WebFetch(domain:papers.nips.cc)",
      "WebFetch(domain:proceedings.neurips.cc)",
      "WebFetch(domain:proceedings.mlr.press)",
      "WebFetch(domain:openreview.net)",
      "WebFetch(domain:mlanthology.org)",
      "WebFetch(domain:dblp.org)",
      "WebFetch(domain:doi.org)",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:ieeexplore.ieee.org)",
      "WebFetch(domain:dl.acm.org)",
      "Bash(./py:*)",
      "Bash(../.venv-rwm311/bin/python -m pip install --target .pylib:*)",
      "Bash(brew install poppler)",
      "Bash(git:*)",
      "Bash(zsh -n:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(awk:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(cmp:*)",
      "Bash(stat:*)",
      "Bash(date:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(shasum:*)",
      "Bash(rm -rf .cache/:*)",
      "Bash(zip:*)",
      "Bash(unzip:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(sysctl:*)",
      "Bash(sw_vers:*)",
      "Bash(uptime:*)",
      "Bash(pgrep:*)",
      "Bash(ps:*)",
      "Bash(pdftotext:*)",
      "Bash(pdfinfo:*)",
      "Bash(pdffonts:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(claude:*)",
      "Bash(./go_rev.zsh:*)",
      "Bash(zsh go_rev.zsh:*)",
      "Bash(zsh ./go_rev.zsh:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git reset --hard:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(scp:*)",
      "Bash(ssh:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(open:*)",
      "Bash(osascript:*)",
      "Bash(mail:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)",
      "Edit(/prereg/PREREG.md)",
      "Edit(/results/**)",
      "Edit(/paper/body.tex)",
      "Edit(/paper/appendix.tex)",
      "Edit(~/Downloads/PDM/rwm_repro/**)",
      "Edit(~/Downloads/PDM/robotic_world_model_lite/**)",
      "Edit(~/Downloads/PDM/rsl_rl_rwm/**)",
      "Edit(~/Downloads/PDM/rwm_analysis/**)",
      "Edit(~/Downloads/PDM/rwm_private/**)",
      "Edit(~/Downloads/PDM/rwm_repro_prepurge_backup/**)",
      "Edit(~/Downloads/PDM/PerconAI/**)",
      "Edit(~/Downloads/PDM/NGCAPS/**)",
      "Edit(~/Downloads/PDM/ICMAI/**)",
      "Edit(~/Downloads/PDM/ICPAIAS/**)",
      "Edit(~/Downloads/PDM/SciPyIndia/**)",
      "Edit(~/Downloads/PDM/report/**)",
      "Edit(~/Downloads/PDM/tmp/**)",
      "Edit(~/Downloads/PDM/.venv-rwm311/**)",
      "Edit(~/Downloads/PDM/.venv-rwm/**)",
      "Edit(~/Downloads/PDM/.claude/**)",
      "Edit(~/Downloads/PDM/*.md)",
      "Edit(~/Downloads/CLAUDE.md)",
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(general-purpose)"
    ]
  },
  "sandbox": {
    "enabled": false
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  }
}
